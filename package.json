{
  "name": "jailmap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node node_modules/prisma-legacy/build/index.js generate --config prisma.legacy.config.ts",
    "test:accounts": "node --experimental-strip-types --test tests/accounts.test.ts",
    "test:support": "node --experimental-strip-types --test tests/support.test.ts",
    "test:source-receipt": "node --experimental-strip-types --test tests/source-receipt.test.ts",
    "test:route-check": "node --experimental-strip-types --test tests/route-check.test.ts",
    "test:watchlist-alerts": "node --experimental-strip-types --test tests/watchlist-alerts.test.ts",
    "test:accounts:http": "node --experimental-strip-types tests/account-http.mts",
    "watchlists:alerts": "node --experimental-strip-types scripts/watchlist-alerts.ts",
    "admin:promote": "node --experimental-strip-types scripts/admin.ts",
    "postinstall": "node node_modules/prisma/dist/prisma.js skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/nodemailer": "^8.0.1",
    "clsx": "^2.1.1",
    "imapflow": "^2.0.5",
    "lucide-react": "^1.41.0",
    "mailparser": "^3.9.28",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "prisma": "^8.0.0-rc.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma-legacy": "npm:prisma@^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
